fit_network = function(size, data) {
nnet(
class ~ x1 + x2,
data = data,
size = size
)
}
nn_2 = fit_network(2, disk_train)
nn_4 = fit_network(4, disk_train)
nn_16 = fit_network(16, disk_train)
plot_boundary_nn(nn_2,disk_train) +
labs(title="Size = 2")
plot_boundary_nn(nn_4,disk_train)
plot_boundary_nn(nn_16,disk_train)
fit_network = function(size, data) {
nnet(
class ~ x1 + x2,
data = data,
size = size
)
}
nn_2 = fit_network(2, disk_train)
nn_4 = fit_network(4, disk_train)
nn_8 = fit_network(8, disk_train)
nn_16 = fit_network(16, disk_train)
plot_boundary_nn(nn_2,disk_train) +
labs(title="Size = 2")
plot_boundary_nn(nn_4,disk_train) +
labs(title="Size = 4")
plot_boundary_nn(nn_8,disk_train) +
labs(title="Size = 8")
plot_boundary_nn(nn_16,disk_train) +
labs(title="Size = 16")
fit_network = function(size, data) {
nnet(
class ~ x1 + x2,
data = data,
size = size
)
}
nn_2 = fit_network(2, disk_train)
nn_4 = fit_network(4, disk_train)
nn_8 = fit_network(8, disk_train)
nn_16 = fit_network(16, disk_train)
library(patchwork)
p1 = plot_boundary_nn(nn_2, disk_train) +
labs(title = "Size = 2")
p2 = plot_boundary_nn(nn_4, disk_train) +
labs(title = "Size = 4")
p3 = plot_boundary_nn(nn_8, disk_train) +
labs(title = "Size = 8")
p4 = plot_boundary_nn(nn_16, disk_train) +
labs(title = "Size = 16")
(p1 + p2) / (p3 + p4)
