req = request(paste0(BASE_URL, path)) |>
req_method(method) |>
req_headers(Authorization = paste("Bearer", TOKEN))
if (!is.null(body)) {
req = req |> req_body_json(body)
}
req |> req_perform()
}
# Safety checks before making any changes
if (any(!override_report$due_date_is_class_day)) {
stop("A due date is not a class day. No changes made.")
}
if (any(
override_report$section3_override_count > 1 |
override_report$section4_override_count > 1
)) {
stop("Duplicate section overrides detected. No changes made.")
}
results = list()
for (i in seq_len(nrow(override_report))) {
a = override_report[i, ]
assignment_id = a$assignment_id
assignment_path = paste0(
"/api/v1/courses/", COURSE_ID,
"/assignments/", assignment_id
)
message("\nProcessing: ", a$name)
# Refresh overrides before editing
overrides = resp_body_json(
canvas_request(paste0(assignment_path, "/overrides")),
simplifyVector = FALSE
)
section3 = Filter(
function(o) !is.null(o$course_section_id) &&
as.character(o$course_section_id) == as.character(SECTION3_ID),
overrides
)
section4 = Filter(
function(o) !is.null(o$course_section_id) &&
as.character(o$course_section_id) == as.character(SECTION4_ID),
overrides
)
if (length(section3) > 1 || length(section4) > 1) {
stop("Duplicate section overrides found for ", a$name,
". Stopped before editing this assignment.")
}
# 1. Update assignment-level defaults for Section 3.
# Preserve the existing availability start date.
assignment_body = list(
assignment = list(
due_at = a$section3_due_new,
lock_at = a$section3_lock_new
)
)
canvas_request(
assignment_path,
method = "PUT",
body = assignment_body
)
# 2. Create or update Section 4's override.
section4_body = list(
assignment_override = list(
due_at = a$section4_due_new,
lock_at = a$section4_lock_new
)
)
if (length(section4) == 1) {
canvas_request(
paste0(assignment_path, "/overrides/", section4[[1]]$id),
method = "PUT",
body = section4_body
)
section4_action = "updated"
} else {
section4_body$assignment_override$course_section_id =
SECTION4_ID
canvas_request(
paste0(assignment_path, "/overrides"),
method = "POST",
body = section4_body
)
section4_action = "created"
}
# 3. Delete only the Section 3 section override, if present.
# Do this only after the default and Section 4 updates succeed.
if (length(section3) == 1) {
canvas_request(
paste0(assignment_path, "/overrides/", section3[[1]]$id),
method = "DELETE"
)
section3_action = "deleted"
} else {
section3_action = "none existed"
}
results[[length(results) + 1]] = data.frame(
assignment_id = assignment_id,
name = a$name,
section3_override = section3_action,
section4_override = section4_action
)
message(
"  Defaults updated; Section 4 override ", section4_action,
"; Section 3 override ", section3_action, "."
)
}
results = do.call(rbind, results)
print(results)
canvas_request(
paste0(assignment_path, "/overrides/", section4[[1]]$id),
method = "PUT",
body = list(
assignment_override = list(
unlock_at = section4_unlock
)
)
)
# Run API for GW #####
# ============================================================
# Group Work and Participation Poll Scheduling
# ============================================================
SECTION3_ID = 148562
SECTION4_ID = 148863
# ------------------------------------------------------------
# 1. Canvas API helper
# ------------------------------------------------------------
canvas_request = function(path, method = "GET", body = NULL) {
req = request(paste0(BASE_URL, path)) |>
req_method(method) |>
req_headers(Authorization = paste("Bearer", TOKEN))
if (!is.null(body)) {
req = req |> req_body_json(body)
}
req |> req_perform()
}
# ------------------------------------------------------------
# 2. Safety checks
# ------------------------------------------------------------
if (nrow(override_report) == 0) {
stop("No dated assignments to update.")
}
if (any(is.na(override_report$default_due)) ||
any(override_report$default_due == "")) {
stop("Missing due dates detected. Rebuild the report and exclude placeholders.")
}
if (any(is.na(override_report$due_date)) ||
any(!override_report$due_date_is_class_day)) {
stop("Missing or invalid class-day dates. No changes made.")
}
if (any(
override_report$section3_override_count > 1 |
override_report$section4_override_count > 1
)) {
stop("Duplicate section overrides detected. No changes made.")
}
# ------------------------------------------------------------
# 3. Prepare result log
# ------------------------------------------------------------
results = list()
# ------------------------------------------------------------
# 4. Update each assignment
# ------------------------------------------------------------
for (i in seq_len(nrow(override_report))) {
a = override_report[i, ]
assignment_id = a$assignment_id
assignment_path = paste0(
"/api/v1/courses/", COURSE_ID,
"/assignments/", assignment_id
)
message("\nProcessing: ", a$name)
# Calculate all times in Pacific local time, then convert to UTC
section3_unlock = canvas_timestamp(a$due_date, "12:30")
section3_due = canvas_timestamp(a$due_date, "13:45")
section3_lock = canvas_timestamp(a$accept_until_date, "12:30")
section4_unlock = canvas_timestamp(a$due_date, "14:00")
section4_due = canvas_timestamp(a$due_date, "15:15")
section4_lock = canvas_timestamp(a$accept_until_date, "14:00")
# Refresh current overrides before editing
overrides = resp_body_json(
canvas_request(paste0(assignment_path, "/overrides")),
simplifyVector = FALSE
)
section3 = Filter(
function(o) !is.null(o$course_section_id) &&
as.character(o$course_section_id) == as.character(SECTION3_ID),
overrides
)
section4 = Filter(
function(o) !is.null(o$course_section_id) &&
as.character(o$course_section_id) == as.character(SECTION4_ID),
overrides
)
if (length(section3) > 1 || length(section4) > 1) {
stop(
"Duplicate section overrides found for ", a$name,
". Stopped before editing this assignment."
)
}
# Step A: Set all assignment-level defaults to Section 3's schedule
canvas_request(
assignment_path,
method = "PUT",
body = list(
assignment = list(
unlock_at = section3_unlock,
due_at = section3_due,
lock_at = section3_lock
)
)
)
# Step B: Create or update Section 4's complete schedule
section4_body = list(
assignment_override = list(
unlock_at = section4_unlock,
due_at = section4_due,
lock_at = section4_lock
)
)
if (length(section4) == 1) {
canvas_request(
paste0(assignment_path, "/overrides/", section4[[1]]$id),
method = "PUT",
body = section4_body
)
section4_action = "updated"
} else {
section4_body$assignment_override$course_section_id =
SECTION4_ID
canvas_request(
paste0(assignment_path, "/overrides"),
method = "POST",
body = section4_body
)
section4_action = "created"
}
# Step C: Remove only the redundant Section 3 section override
# This is done after the default and Section 4 updates succeed.
if (length(section3) == 1) {
canvas_request(
paste0(assignment_path, "/overrides/", section3[[1]]$id),
method = "DELETE"
)
section3_action = "deleted"
} else {
section3_action = "none existed"
}
# Record successful completion of this assignment
results[[length(results) + 1]] = data.frame(
assignment_id = assignment_id,
name = a$name,
section3_available_from = section3_unlock,
section3_due = section3_due,
section3_available_until = section3_lock,
section4_available_from = section4_unlock,
section4_due = section4_due,
section4_available_until = section4_lock,
section3_override = section3_action,
section4_override = section4_action
)
message(
"  Completed. Section 4 override ", section4_action,
"; Section 3 override ", section3_action, "."
)
}
# ------------------------------------------------------------
# 5. Display results
# ------------------------------------------------------------
results = do.call(rbind, results)
print(results, row.names = FALSE)
View(results)
