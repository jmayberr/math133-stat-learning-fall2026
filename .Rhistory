formula=fantasy_points_ppr ~
position+
carries_pg +
targets_pg +
yards_per_carry +
yards_per_target +
tds_per_carry +
tds_per_target +
def_fantasy_points_pg+
weeks_missed+
age
lm_model=lm(formula,data=model_data)
library(bundle)
library(torch)   # brulee depends on torch being loaded to unbundle correctly
nn_bundle <- readRDS("nn_model.rds")
nn_model <- bundle::unbundle(nn_bundle)
# Calculate predictions
lm_predictions <- prediction_data %>%
dplyr::mutate(predicted_ppr = predict(lm_model, newdata = prediction_data)) %>%
dplyr::select(player_display_name, position, team, opponent_team, predicted_ppr) %>%
dplyr::arrange(dplyr::desc(predicted_ppr))
nn_predictions <- predict(nn_model, new_data = prediction_data) %>%
dplyr::bind_cols(
prediction_data %>%
dplyr::select(player_display_name, position, team, opponent_team)
) %>%
dplyr::rename(predicted_ppr = .pred) %>%
dplyr::select(player_display_name, position, team, opponent_team, predicted_ppr) %>%
dplyr::arrange(dplyr::desc(predicted_ppr))
comparison <- lm_predictions %>%
dplyr::rename(lm_pred = predicted_ppr) %>%
dplyr::left_join(
nn_predictions %>% dplyr::rename(nn_pred = predicted_ppr),
by = c("player_display_name", "position", "team", "opponent_team")
) %>%
dplyr::arrange(dplyr::desc(lm_pred))
comparison
