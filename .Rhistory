acc=function(pred,real){
sum(pred==real)/length(real)
}
bal_acc=function(pred,real){
tp=sum(pred==1&real==1)/sum(real==1)
tn=sum(pred==0&real==0)/sum(real==0)
(tp+tn)/2
}
