library(tidymodels)
set.seed(516)
df_url = "https://raw.githubusercontent.com/jmayberr/math133-stat-learning-fall2026/refs/heads/main/Datasets/election2016.csv"
election2016 = read.csv(df_url)
lasso_spec=linear_reg(penalty = tune(),mixture=1) |>
set_engine("glmnet")
grid=grid_regular(penalty(c(-3,1)),levels=50)
lasso_fit=tune_grid(lasso_spec,
trump.vote ~ .,
cv_plan,
grid = tibble(penalty = lambda))
lambda_grid=grid_regular(penalty(c(-3,1)),levels=50)
lasso_fit=tune_grid(lasso_spec,
trump.vote ~ .,
cv_plan,
grid = lambda_grid)
autoplot(lasso_fit)
cv_plan=vfold_cv(election2016[,2:10],v=10)
lambda_grid=grid_regular(penalty(c(-3,1)),levels=50)
lasso_fit=tune_grid(lasso_spec,
trump.vote ~ .,
cv_plan,
grid = lambda_grid)
autoplot(lasso_fit)
collect_metrics(lasso_fit)
lambda_grid=grid_regular(penalty(c(-3,3)),levels=50)
lasso_fit=tune_grid(lasso_spec,
trump.vote ~ .,
cv_plan,
grid = lambda_grid)
autoplot(lasso_fit)
collect_metrics(lasso_fit)
lambda_grid=grid_regular(penalty(c(-3,0)),levels=50)
lasso_fit=tune_grid(lasso_spec,
trump.vote ~ .,
cv_plan,
grid = lambda_grid)
autoplot(lasso_fit)
collect_metrics(lasso_fit)
# Step 1: Model specification with penalty to tune
ridge_spec = linear_reg(penalty = tune(), mixture = 0) |>
set_engine("glmnet")
# Step 2: Resampling plan; you can do repeats = 10 as well, but it takes longer to run
cv_plan = vfold_cv(election2016[,2:10], v = 10)
# Step 3: Define grid of lambda values and tune
lambda_grid = grid_regular(penalty(c(-3,0)), levels = 50)
ridge_fit = tune_grid(
ridge_spec,
trump.vote ~ .,
resamples = cv_plan,
grid = lambda_grid
)
# Visualize tuning results
autoplot(ridge_fit)
# Find best lambda
best_lambda = select_best(ridge_fit, metric = "rmse")
best_lambda
# Step 1: Model specification with penalty to tune
ridge_spec = linear_reg(penalty = tune(), mixture = 0) |>
set_engine("glmnet")
# Step 2: Resampling plan; you can do repeats = 10 as well, but it takes longer to run
cv_plan = vfold_cv(election2016[,2:10], v = 10)
# Step 3: Define grid of lambda values and tune
# Note: c(-3,0) sets the range of lambda from 10^(-3) to 10^0
lambda_grid = grid_regular(penalty(c(-3,1)), levels = 50)
ridge_fit = tune_grid(
ridge_spec,
trump.vote ~ .,
resamples = cv_plan,
grid = lambda_grid
)
# Visualize tuning results
autoplot(ridge_fit)
# Find best lambda
best_lambda = select_best(ridge_fit, metric = "rmse")
best_lambda
# Step 1: Model specification with penalty to tune
ridge_spec = linear_reg(penalty = tune(), mixture = 0) |>
set_engine("glmnet")
# Step 2: Resampling plan; you can do repeats = 10 as well, but it takes longer to run
cv_plan = vfold_cv(election2016[,2:10], v = 10)
# Step 3: Define grid of lambda values and tune
# Note: c(-3,0) sets the range of lambda from 10^(-3) to 10^0
lambda_grid = grid_regular(penalty(c(-3,0)), levels = 50)
ridge_fit = tune_grid(
ridge_spec,
trump.vote ~ .,
resamples = cv_plan,
grid = lambda_grid
)
# Visualize tuning results
autoplot(ridge_fit)
# Find best lambda
best_lambda = select_best(ridge_fit, metric = "rmse")
best_lambda
# Step 1: Elastic net with both parameters to tune
elastic_spec = linear_reg(penalty = tune(), mixture = tune()) |>
set_engine("glmnet")
# Step 2: Resampling plan (same as before)
cv_plan = vfold_cv(election2016[,2:10], v = 10)
# Step 3: 10x10 grid over both parameters (100 models total)
# Could do 20x20  by switching levels = 20 but it takes a while to run
elastic_grid = grid_regular(
penalty(c(-3,0)),
mixture(c(0,1)),
levels = 10
)
elastic_fit = tune_grid(
elastic_spec,
trump.vote ~ .,
resamples = cv_plan,
grid = elastic_grid
)
autoplot(elastic_fit)
best_params = select_best(elastic_fit, metric = "rmse")
best_params
