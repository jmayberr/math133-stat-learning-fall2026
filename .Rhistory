cv_plan=vfold_cv(train_set,v=10)
table(penguins$species)
table(penguins$island)
rf_tune=tune_grid(rf_spec,
species~.,
cv_plan,
grid)
grid=grid_regular(mtry=range(1,7), levels=8)
grid=grid_regular(mtry(range=c(1,7)), levels=8)
rf_tune=tune_grid(rf_spec,
species~.,
cv_plan,
grid)
select_best(rf_tune,mtry)
select_best(rf_tune,metric="rmse")
select_best(rf_tune,metric="accuracy")
select_best(rf_tune,metric="roc_auc")
select_best(rf_tune,metric="brier_class")
select_best(rf_tune,metric="accuracy")
