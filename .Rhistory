library(tidyverse)
set.seed(123)
x=seq(-10,10,by=0.1)
y=2*x^2-3*x+5+rnorm(length(x))
df=data.frame(x=x,y=y)
df |>
ggplot(aes(x=x,y=y))+geom_point()+
geom_smooth(method="lm",se=FALSE)
fake_lm=lm(y~x,data=df)
df |>
mutate(yhat=predict(fake_lm,df),
res=y-yhat) |>
ggplot(aes(x=yhat,y=res))+
geom_point()+
labs(x="Predicted Values",y="Residuals")
