grid$pred_class = predict(model, data, type = "class")
grid = grid |>
mutate(pred_class = factor(pred_class, levels = c("A", "B")))
ggplot() +
geom_raster(
data = grid,
aes(x1, x2, fill = pred_class),
alpha = 0.2
) +
geom_point(
data = fake_data,
aes(x1, x2, color = class),
alpha = 0.7
) +
scale_fill_manual(values = class_colors) +
scale_color_manual(values = class_colors) +
coord_equal() +
labs(
x = "X1",
y = "X2",
color = "Observed class",
fill = "Predicted class"
) +
theme_minimal()
}
plot_boundary(
disk_train,
disk_nn
)
plot_boundary_nn=function(model,data){
grid = expand_grid(
x1 = seq(min(data$x1) - 0.5, max(data$x1) + 0.5,
length.out = 250),
x2 = seq(min(data$x2) - 0.5, max(data$x2) + 0.5,
length.out = 250)
)
grid$pred_class = predict(model, data, type = "class")
grid = grid |>
mutate(pred_class = factor(pred_class, levels = c("A", "B")))
ggplot() +
geom_raster(
data = grid,
aes(x1, x2, fill = pred_class),
alpha = 0.2
) +
geom_point(
data = fake_data,
aes(x1, x2, color = class),
alpha = 0.7
) +
scale_fill_manual(values = class_colors) +
scale_color_manual(values = class_colors) +
coord_equal() +
labs(
x = "X1",
y = "X2",
color = "Observed class",
fill = "Predicted class"
) +
theme_minimal()
}
plot_boundary(
disk_nn,
disk_train
)
plot_boundary_nn=function(model,data){
grid = expand_grid(
x1 = seq(min(data$x1) - 0.5, max(data$x1) + 0.5,
length.out = 250),
x2 = seq(min(data$x2) - 0.5, max(data$x2) + 0.5,
length.out = 250)
)
grid$pred_class = predict(model, grid, type = "class")
grid = grid |>
mutate(pred_class = factor(pred_class, levels = c("A", "B")))
ggplot() +
geom_raster(
data = grid,
aes(x1, x2, fill = pred_class),
alpha = 0.2
) +
geom_point(
data = data,
aes(x1, x2, color = class),
alpha = 0.7
) +
scale_fill_manual(values = class_colors) +
scale_color_manual(values = class_colors) +
coord_equal() +
labs(
x = "X1",
y = "X2",
color = "Observed class",
fill = "Predicted class"
) +
theme_minimal()
}
