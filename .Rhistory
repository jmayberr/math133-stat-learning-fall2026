mnist_df = readRDS("Datasets/mnist_train.rds")
library(nnet)
set.seed(1123)
n=nrow(mnist_df)
N=10000
indices = sample(n,N+500)
train = mnist_df[indices[1:N], ]
test = mnist_df[indices[(N+1):(N+500)], ]
# Fit a neural network classifier
library(nnet)
mnist_nnet = nnet(
digit ~ .,
data = train,
size = 10,
MaxNWts = 10000,
trace = FALSE
)
preds=predict(mnist_nnet,newdata=test,type="class")
sum(test$digit==preds)/500
library(torch)
digit_net = nn_module(
initialize = function() {
self$hidden1 = nn_linear(784, 128)
self$hidden2 = nn_linear(128, 64)
self$output = nn_linear(64, 10)
self$relu = nn_relu()
},
forward = function(x) {
x = self$relu(self$hidden1(x))
x = self$relu(self$hidden2(x))
x = self$output(x)
x
}
)
set.seed(1123)
n=nrow(mnist_df)
N=1000
indices = sample(n,N+500)
train = mnist_df[indices[1:N], ]
test = mnist_df[indices[(N+1):(N+500)], ]
# Convert pixel values to tensors
x_train = torch_tensor(
as.matrix(train[, 1:784]),
dtype = torch_float()
)
x_test = torch_tensor(
as.matrix(test[, 1:784]),
dtype = torch_float()
)
# Convert digit labels to integers 1 through 10
y_train = torch_tensor(
as.integer(as.character(train$digit)) + 1,
dtype = torch_long()
)
y_test = torch_tensor(
as.integer(as.character(test$digit)) + 1,
dtype = torch_long()
)
model = digit_net()
optimizer = optim_adam(
model$parameters,
lr = 0.001
)
loss_fn = nn_cross_entropy_loss()
epochs = 30
batch_size = 64
for (epoch in 1:epochs) {
model$train()
total_loss = 0
# Shuffle observations each epoch
order = sample.int(nrow(train))
for (i in seq(1, length(order), by = batch_size)) {
idx = order[i:min(i + batch_size - 1, length(order))]
optimizer$zero_grad()
output = model(x_train[idx, ])
loss = loss_fn(output, y_train[idx])
loss$backward()
optimizer$step()
total_loss = total_loss + loss$item()
}
cat(
"Epoch:", epoch,
"Average loss:", round(total_loss / ceiling(length(order) / batch_size), 4),
"\n"
)
}
model$eval()
with_no_grad({
test_output = model(x_test)
predictions = test_output$argmax(dim = 2)
})
predicted_digits = as.integer(as_array(predictions)) - 1
actual_digits = as.integer(as.character(test$digit))
mean(predicted_digits == actual_digits)
