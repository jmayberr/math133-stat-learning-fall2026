)
disk_train = disk_train |>
mutate(r = sqrt(x1^2 + x2^2))
disk_test = disk_test |>
mutate(r = sqrt(x1^2 + x2^2))
disk_glm_radius = glm(
class ~ r,
data = disk_train,
family = binomial
)
plot_radius_boundary = function(data, model) {
grid = expand_grid(
x1 = seq(min(data$x1) - 0.5, max(data$x1) + 0.5,
length.out = 250),
x2 = seq(min(data$x2) - 0.5, max(data$x2) + 0.5,
length.out = 250)
) |>
mutate(r = sqrt(x1^2 + x2^2))
grid$p_B = predict(model, newdata = grid, type = "response")
grid$pred = factor(
if_else(grid$p_B > 0.5, "B", "A"),
levels = c("A", "B")
)
ggplot() +
geom_raster(
data = grid,
aes(x1, x2, fill = pred),
alpha = 0.2
) +
geom_contour(
data = grid,
aes(x1, x2, z = p_B),
breaks = 0.5,
color = "black",
linewidth = 1
) +
geom_point(
data = data,
aes(x1, x2, color = class),
alpha = 0.7
) +
scale_fill_manual(values = class_colors) +
scale_color_manual(values = class_colors) +
coord_equal() +
labs(
title = "Classification boundary from the radius model",
x = "X1",
y = "X2",
fill = "Predicted class",
color = "Observed class"
) +
theme_minimal()
}
plot_radius_boundary(disk_train, disk_glm_radius)
