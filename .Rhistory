library(xgboost)
# Models specs
gbm_spec=boost_tree(
trees=tune(),
tree_depth=tune(),
learn_rate=tune(),
min_n=5,
sample_size=0.8) |>
set_engine("xgboost") |>
set_mode("regression")
# Resampling procedure
cv_plan =vfold_cv(train[,2:10],v=5)
# Tune Model
gbm_tune=tune_grid(
gbm_spec,
trump.vote~.,
cv_plan,
grid=20
)
best_params=select_best(gbm_tune,metric="rmse")
print(best_params)
gbm_final=finalize_model(gbm_spec,best_params)
gbm_fit=fit(gbm_final,
trump.vote~.,
train[,2:10])
gbm_pred=predict(gbm_fit,test)$.pred
cat("RMSE is",sqrt(mean((test$trump.vote-gbm_pred)^2)))
library(tidymodels)
library(xgboost)
# Models specs
gbm_spec=boost_tree(
trees=tune(),
tree_depth=tune(),
learn_rate=tune(),
min_n=5,
sample_size=0.8) |>
set_engine("xgboost") |>
set_mode("regression")
# Resampling procedure
cv_plan =vfold_cv(train[,2:10],v=5)
# Recommended - tidymodels native
tune_grid <- grid_regular(
trees(range = c(100, 1000)),
tree_depth(range = c(1, 4)),
learn_rate(range = c(-3, -1)),  # log10 scale
levels = c(10, 4, 3)
)
# Tune Model
gbm_tune=tune_grid(
gbm_spec,
trump.vote~.,
cv_plan,
grid=tune_grid
)
collect_metrics(gbm_tune)
best_params=select_best(gbm_tune,metric="rmse")
print(best_params)
gbm_final=finalize_model(gbm_spec,best_params)
gbm_fit=fit(gbm_final,
trump.vote~.,
train[,2:10])
gbm_pred=predict(gbm_fit,test)$.pred
cat("RMSE is",sqrt(mean((test$trump.vote-gbm_pred)^2)))
# Tune Mtry for rf ####
rf_spec=rand_forest(mtry=tune()) |>
set_engine("ranger") |>
set_mode("classification")
pacman::p_load(tidyverse,palmerpenguins,rpart,rattle,randomForest,tidymodels)
penguins2=penguins |>
drop_na()
n=nrow(penguins2)
set.seed(55)
s=sample(n,round(.7*n,0))
train_set=penguins2[s,]
test_set=penguins2[-s,]
head(train_set)
cv_plan=vfold_cv(train_set,folds=10)
cv_plan=vfold_cv(train_set,v=10)
table(penguins$species)
table(penguins$island)
rf_tune=tune_grid(rf_spec,
species~.,
cv_plan,
grid)
grid=grid_regular(mtry=range(1,7), levels=8)
grid=grid_regular(mtry(range=c(1,7)), levels=8)
rf_tune=tune_grid(rf_spec,
species~.,
cv_plan,
grid)
select_best(rf_tune,mtry)
select_best(rf_tune,metric="rmse")
select_best(rf_tune,metric="accuracy")
select_best(rf_tune,metric="roc_auc")
select_best(rf_tune,metric="brier_class")
select_best(rf_tune,metric="accuracy")
best_param=select_best(rf_tune,metric="accuracy")
rf_final=finalize_model(rf_spec,best_param)
rf_fit=fit(rf_final,
species~.,
train_set)
rf_fit
collect_metrics(rf_fit)
extract_fit_engine(rf_fit)$prediction.error
predict(rf_fit,test_set)
table(test_set$species,pred_species)
pred_species=predict(rf_fit,test_set)$.pred_class
table(test_set$species,pred_species)
