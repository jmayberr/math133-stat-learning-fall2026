learn_rate=tune(),
min_n=5,
sample_size=0.8) |>
set_engine("xgboost") |>
set_mode("regression")
# Resampling procedure
cv_plan =vfold_cv(train[,2:10],v=5)
# Define tune grid
grid=expand.grid(trees=seq(100,1000,by=100),
tree_depth=1:4,
learn_rate=c(0.001,0.01,0.1)
)
# Tune Model
gbm_tune=tune_grid(
gbm_spec,
trump.vote~.,
cv_plan,
grid
)
collect_metrics(gbm_tune)
names(grid)
