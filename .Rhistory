# Prediction using wopr
predict_wr_ppr = function(
week,
player_names,
season = 2026,
wr_data,
train_through = 2025
) {
# 1. Fit both models using the same historical data
train = wr_data %>%
dplyr::filter(season <= train_through) %>%
tidyr::drop_na(
actual_ppr,
prior_ppr_avg,
prior_wopr,
defense
) %>%
dplyr::mutate(defense = factor(defense))
# Original model: past PPR + WOPR + defense
wr_model_full = lm(
actual_ppr ~ prior_ppr_avg + prior_wopr + defense,
data = train
)
# Comparison model: WOPR + defense only
wr_model_wopr_defense = lm(
actual_ppr ~ prior_wopr + defense,
data = train
)
# 2. Match requested names to player IDs
requested = tibble::tibble(
requested_name = player_names,
name_key = stringr::str_to_lower(
stringr::str_squish(player_names)
)
)
player_lookup = wr_data %>%
dplyr::distinct(player_id, player_display_name) %>%
dplyr::mutate(
name_key = stringr::str_to_lower(
stringr::str_squish(player_display_name)
)
) %>%
dplyr::inner_join(requested, by = "name_key") %>%
dplyr::distinct(player_id, .keep_all = TRUE)
missing_names = setdiff(
requested$name_key,
player_lookup$name_key
)
if (length(missing_names) > 0) {
stop(
"Could not find: ",
paste(missing_names, collapse = ", ")
)
}
# 3. Get each player's previous games this season
history = wr_data %>%
dplyr::filter(
.data$season == .env$season,
.data$week < .env$week
) %>%
dplyr::semi_join(player_lookup, by = "player_id") %>%
dplyr::arrange(player_id, week) %>%
dplyr::group_by(player_id) %>%
dplyr::summarise(
prior_ppr_avg = mean(actual_ppr, na.rm = TRUE),
prior_wopr = if (dplyr::n() >= 3) {
mean(tail(wopr, 3), na.rm = TRUE)
} else {
NA_real_
},
games_played = dplyr::n(),
team = dplyr::last(team),
.groups = "drop"
)
# 4. Retrieve the requested week's schedule
schedule = nflreadr::load_schedules(season) %>%
dplyr::filter(
.data$season == .env$season,
.data$week == .env$week,
game_type == "REG"
)
team_schedule = dplyr::bind_rows(
schedule %>%
dplyr::transmute(
team = home_team,
defense = away_team
),
schedule %>%
dplyr::transmute(
team = away_team,
defense = home_team
)
)
# 5. Assemble prediction data
new_data = player_lookup %>%
dplyr::left_join(history, by = "player_id") %>%
dplyr::left_join(team_schedule, by = "team") %>%
dplyr::mutate(
defense = factor(
defense,
levels = wr_model_full$xlevels$defense
)
)
# Validate predictors and opponent information
if (
any(is.na(new_data$prior_ppr_avg)) ||
any(is.na(new_data$prior_wopr))
) {
stop(
"At least one player lacks sufficient prior game ",
"data to calculate the predictors."
)
}
if (any(is.na(new_data$defense))) {
stop(
"A player has no scheduled opponent or the defense ",
"was not represented in the training data."
)
}
# 6. Generate predictions from both models
new_data %>%
dplyr::mutate(
predicted_ppr_full = as.numeric(
predict(wr_model_full, newdata = new_data)
),
predicted_ppr_wopr_defense = as.numeric(
predict(wr_model_wopr_defense, newdata = new_data)
),
prediction_difference =
predicted_ppr_full - predicted_ppr_wopr_defense
) %>%
dplyr::select(
player = player_display_name,
team,
defense,
games_played,
prior_ppr_avg,
prior_wopr,
predicted_ppr_full,
predicted_ppr_wopr_defense,
prediction_difference
) %>%
dplyr::arrange(dplyr::desc(predicted_ppr_full))
}
week8_predictions = predict_wr_ppr(
week = 8,
player_names = c(
"Tre Tucker",
"Omar Cooper Jr.",
"Michael Wilson",
"A.J. Brown",
"Tetairoa McMillan"
),
season = 2026,
wr_data = wr_data,
train_through = 2026
)
