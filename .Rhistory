nba_games = nba_games %>%
mutate(
double_double_categories =
(points >= 10) +
(rebounds >= 10) +
(assists >= 10) +
(steals >= 10) +
(blocks >= 10),
double_double_bonus =
if_else(double_double_categories >= 2, 1, 0) +
if_else(double_double_categories >= 3, 2, 0),
scoring_bonus =
if_else(points >= 40, 2, 0) +
if_else(points >= 50, 2, 0),
fantasy_points =
points +
rebounds +
assists +
2 * steals +
2 * blocks +
0.5 * three_made +
double_double_bonus +
scoring_bonus
)
