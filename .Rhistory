)
apply(small_reconstructed[1:10, ], 2, sd) |> summary()
# Fit a network to just 10 observations
autoencoder_tiny = nnet(
x = as.matrix(train[1:10, 1:100]),
y = as.matrix(train[1:10, 1:100]),
size = 8,
linout = TRUE,
decay = 0,
maxit = 1000,
MaxNWts = 10000,
trace = TRUE
)
tiny_pred = predict(
autoencoder_tiny,
newdata = as.matrix(train[1:10, 1:100])
)
# Compare predictions across observations
apply(tiny_pred, 2, sd) |> summary()
# Training reconstruction error
mean((tiny_pred - as.matrix(train[1:10, 1:100]))^2)
# Predictions on the training observations
tiny_train_pred = predict(
autoencoder_tiny,
newdata = as.matrix(train[1:10, 1:100])
)
# Predictions on the test observations
tiny_test_pred = predict(
autoencoder_tiny,
newdata = as.matrix(test[1:10, 1:100])
)
# Variation across reconstructed training observations
apply(tiny_train_pred, 2, sd) |> summary()
# Variation across reconstructed test observations
apply(tiny_test_pred, 2, sd) |> summary()
dim(tiny_pred)
dim(as.matrix(train[1:10, 1:100]))
