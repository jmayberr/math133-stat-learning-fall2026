m = calculate_metrics(yhat, y, "1")
tibble(
cutoffs = cutoff,
bal_acc=m$Balanced_Accuracy
)
})
plot(results$cutoffs, results$bal_acc,
xlab = "Cutoff for Positive Classification",
ylab = "Balanced Accuracy")
