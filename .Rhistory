for (i in 1:p){
yhat=numeric(nrow(newdata))
for (j in 1:nrow(df)){
train=df[-j,]
test=df[j,]
train_regsubsets=regsubsets(fla,train,nvmax=i)
yhat[j]=predict_regsubsets(fit_reg,test,i)
}
rmse[i]=sqrt(mean((y-yhat)^2))
}
return(rmse)
}
