library(slider)
rolling_predictors = function(data, k = 12, weights = 1:k) {
if (length(weights) != k) {
stop("weights must have length k")
}
stat_cols <- c(
"carries", "targets", "rushing_yards", "receiving_yards",
"receptions", "rushing_tds", "receiving_tds"
)
data %>%
dplyr::arrange(player_id, season, week) %>%
dplyr::group_by(player_id) %>%
dplyr::mutate(
# Number of regular-season weeks between this game
# and the player's next game.
# Gaps between seasons are ignored.
gap_to_next_game = dplyr::if_else(
season == dplyr::lead(season),
dplyr::lead(week) - week - 1,
0
),
# Number of weeks between the previous game
# and the current prediction week.
# (Kept as a standalone feature -- e.g. "coming off how many
# missed weeks" -- but NOT added into weeks_missed below,
# since it's already captured inside that rolling window.)
gap_from_previous_game = dplyr::if_else(
season == dplyr::lag(season),
week - dplyr::lag(week) - 1,
0
),
# Weeks missed among the previous k games (byes included,
# since we're not yet joining in team schedules).
#
# lag(gap_to_next_game) gives the gaps BETWEEN
# each pair of previous games, and the sliding window of
# width k already reaches from the current row back through
# the gap connecting the 12th-previous game up to the
# most recent previous game -- so no separate term needs
# to be added for the "most recent gap."
weeks_missed = slider::slide_dbl(
dplyr::lag(gap_to_next_game),
~ sum(.x, na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
# Rolling weighted per-game stats (volume + underlying totals)
dplyr::across(
dplyr::all_of(stat_cols),
~ slider::slide_dbl(
dplyr::lag(.x),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
.names = "{.col}_pg"
),
# Rolling efficiency measures
yards_per_carry = ifelse(
carries_pg > 0,
rushing_yards_pg / carries_pg,
0
),
yards_per_target = ifelse(
targets_pg > 0,
receiving_yards_pg / targets_pg,
0
),
receptions_per_target = ifelse(
targets_pg > 0,
receptions_pg / targets_pg,
0
),
tds_per_carry = ifelse(
carries_pg > 0,
rushing_tds_pg / carries_pg,
0
),
tds_per_target = ifelse(
targets_pg > 0,
receiving_tds_pg / targets_pg,
0
)
) %>%
dplyr::ungroup() %>%
# Only return observations we actually want to model
dplyr::filter(season >= 2025)
}
player_weekly_roll <- rolling_predictors(player_weekly)
player_weekly_roll |>
dplyr::filter(
player_display_name == "Bijan Robinson",
season==2025
) |>
select(season, week, carries, carries_pg,weeks_missed)
# Rolling Defense ####
library(slider)
# Step 1: build weekly defense fantasy points (one row per team per week)
build_defense_weekly <- function(seasons) {
team_stats <- nflreadr::load_team_stats(seasons, summary_level = "week")
schedule <- nflreadr::load_schedules(seasons) %>%
dplyr::filter(game_type == "REG") %>%
dplyr::select(season, week, game_id, away_team, away_score, home_team, home_score)
points_allowed <- dplyr::bind_rows(
schedule %>% dplyr::transmute(season, week, team = home_team, points_allowed = away_score),
schedule %>% dplyr::transmute(season, week, team = away_team, points_allowed = home_score)
) %>%
dplyr::mutate(
pa_points = dplyr::case_when(
points_allowed == 0                        ~ 10,
points_allowed >= 1  & points_allowed <= 6  ~ 7,
points_allowed >= 7  & points_allowed <= 13 ~ 4,
points_allowed >= 14 & points_allowed <= 20 ~ 1,
points_allowed >= 21 & points_allowed <= 27 ~ 0,
points_allowed >= 28 & points_allowed <= 34 ~ -1,
points_allowed >= 35                        ~ -4
)
)
team_stats %>%
dplyr::left_join(points_allowed, by = c("season", "week", "team")) %>%
dplyr::mutate(
def_fantasy_points_wk =
pa_points +
def_sacks +
def_fumbles_forced +
2 * def_interceptions +
2 * def_fumbles +
6 * def_tds +
2 * def_safeties +
2 * (def_punt_blocks + def_pat_blocks + def_fg_blocks)
) %>%
dplyr::select(team, season, week, def_fantasy_points_wk)
}
# Step 2: rolling trailing-12-game average, same pattern as rolling_predictors()
rolling_defense <- function(data, k = 12, weights = 1:k) {
if (length(weights) != k) {
stop("weights must have length k")
}
data %>%
dplyr::arrange(team, season, week) %>%
dplyr::group_by(team) %>%
dplyr::mutate(
# Was the team coming off a bye going into this game?
coming_off_bye = dplyr::if_else(
season == dplyr::lag(season),
(week - dplyr::lag(week) - 1) > 0,
FALSE
),
def_fantasy_points_pg = slider::slide_dbl(
dplyr::lag(def_fantasy_points_wk),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
)
) %>%
dplyr::ungroup() %>%
dplyr::filter(season >= 2025)
}
# Usage: pull 2024 onward so 2025 week 1-2 rows have real trailing history
defense_weekly <- build_defense_weekly(2024:2025)
defense_rolling <- rolling_defense(defense_weekly, k = 12, weights = 1:12)
