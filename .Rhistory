library(nnet)
eval_nn=data.frame(size=c(2,4,8,16,32),acc=NA,bal_acc=NA)
for (i in 1:nrow(eval_nn)){
legend_nn=nnet(factor(Legendary)~.,
data=train[,5:11],
size=eval_nn$size[i])
yhat=predict(legend_nn,test,type="class")
eval_nn$acc[i]=sum(yhat==test$Legendary)/nrow(test)
recall=sum(yhat==TRUE&test$Legendary==TRUE)/sum(test$Legendary==TRUE)
specificity=sum(yhat==FALSE&test$Legendary==FALSE)/sum(test$Legendary==FALSE)
eval_nn$bal_acc[i]=(recall+specificity)/2
}
eval_nn
