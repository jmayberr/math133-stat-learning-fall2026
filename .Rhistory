receiving_yards_pg = slider::slide_dbl(
dplyr::lag(receiving_yards),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
receptions_pg = slider::slide_dbl(
dplyr::lag(receptions),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
rushing_tds_pg = slider::slide_dbl(
dplyr::lag(rushing_tds),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
receiving_tds_pg = slider::slide_dbl(
dplyr::lag(receiving_tds),
~ weighted.mean(.x, w = weights[seq_along(.x)], na.rm = TRUE),
.before = k - 1,
.complete = FALSE
),
# Rolling efficiency measures
yards_per_carry = ifelse(
carries_pg > 0,
rushing_yards_pg / carries_pg,
0
),
yards_per_target = ifelse(
targets_pg > 0,
receiving_yards_pg / targets_pg,
0
),
receptions_per_target = ifelse(
targets_pg > 0,
receptions_pg / targets_pg,
0
),
tds_per_carry = ifelse(
carries_pg > 0,
rushing_tds_pg / carries_pg,
0
),
tds_per_target = ifelse(
targets_pg > 0,
receiving_tds_pg / targets_pg,
0
)
) %>%
dplyr::ungroup()
}
player_weekly_roll <- rolling_predictors(player_weekly)
# Merge Data ####
model_data <- skill_2025 |>
left_join(
player_weekly_roll,
by = c("player_id","player_display_name","position","season","week")
) |>
left_join(
defense_2024,
by = c("opponent_team" = "team")
) |>
left_join(
player_age,
by = "player_id"
) |>
select(-team.y) |>
rename(team=team.x)
write.csv(model_data,"Datasets/fantasy2025.csv",row.names = FALSE)
