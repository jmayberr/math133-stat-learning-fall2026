df_url=url('https://instruction.bus.wisc.edu/jfrees/jfreesbooks/Regression%20Modeling/BookWebDec2010/CSVData/InflationBond.csv')
inflationBond=read.csv(df_url)
inflationBond$date=dmy(inflationBond$date)
cbar=mean(inflationBond$INFBOND)
sd_c=sd(inflationBond$INFBOND)
ggplot(inflationBond,aes(x=date,y=INFBOND))+
geom_point(shape=1)+geom_line()+
geom_hline(yintercept = cbar)+
geom_hline(yintercept = cbar-3*sd_c,linetype = "dashed")+
geom_hline(yintercept = cbar+3*sd_c,linetype = "dashed")
library(lubridate)
df_url=url('https://instruction.bus.wisc.edu/jfrees/jfreesbooks/Regression%20Modeling/BookWebDec2010/CSVData/InflationBond.csv')
inflationBond=read.csv(df_url)
inflationBond$date=dmy(inflationBond$date)
cbar=mean(inflationBond$INFBOND)
c_sd=sd(inflationBond$INFBOND)
ggplot(inflationBond,aes(x=date,y=INFBOND))+
geom_point(shape=1)+geom_line()+
geom_hline(yintercept = cbar)+
geom_hline(yintercept = cbar-3*c_sd,linetype = "dashed")+
geom_hline(yintercept = cbar+3*c_sd,linetype = "dashed")
rhoIB=acf(inflationBond$INFBOND)
rho1=rhoIB$acf[2]
ybar=mean(inflationBond$INFBOND)
T=length(inflationBond$INFBOND)
x=inflationBond$INFBOND[1:(T-1)]
y=inflationBond$INFBOND[2:T]
infbond_lm=lm(y~x)
cat("Coefficients from lm:", coef(infbond_lm))
cat("\nCoefficients from theory:",c((1-rho1)*ybar,rho1))
rhoIB=acf(inflationBond$INFBOND)
curve(rho1^x,add=TRUE,col="#e35209")
infBond_ar=ar(inflationBond$INFBOND,order.max=1)
preds10=predict(infBond_ar,n.ahead = 10)
forecast10=data.frame(N.Ahead=1:10,
Low=preds10$pred-2*preds10$se,
Intermediate=preds10$pred,
High=preds10$pred+2*preds10$se) %>%
pivot_longer(Low:High,names_to="type",values_to="value")
cb_palette = c("#000000", "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7")
ggplot(forecast10,aes(x=N.Ahead,y=value,color=type))+
geom_point(shape=1)+geom_line()+
scale_color_manual(values=cb_palette[c(7,1,4)])
