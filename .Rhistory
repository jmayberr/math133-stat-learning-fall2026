# 1. Extract Input-to-Hidden weights (First 25 weights)
# Arranged as a 5x5 matrix (Rows = Inputs/Bias, Columns = Hidden Units)
w_input_to_hidden <- matrix(model$wts[1:25], nrow = 5, ncol = 5, byrow = TRUE)
rownames(w_input_to_hidden) <- c("Bias", colnames(iris)[1:4])
colnames(w_input_to_hidden) <- paste0("H", 1:5)
# 2. Extract Hidden-to-Output weights (Remaining 18 weights)
# Arranged as a 6x3 matrix (Rows = Hidden/Bias, Columns = Outputs)
w_hidden_to_output <- matrix(model$wts[26:43], nrow = 6, ncol = 3, byrow = TRUE)
rownames(w_hidden_to_output) <- c("Bias", paste0("H", 1:5))
colnames(w_hidden_to_output) <- levels(iris$Species)
