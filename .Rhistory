# Step 1: Model specification
rf_specs=rand_forest(mtry=tune()) |>
set_engine("ranger") |>  # can also use randomForest but ranger is usually preferred
set_mode("regression")
# Step 2: Resampling procedure - use same cv_plan as before
# Step 3: Parameter tuning/ Model evaluation
# Set mtry_grid
mtry_grid=grid_regular(
finalize(mtry(),train_set[,4:19]), #This line gives mtry the range of 1 to max number of features
levels = 5)  #Sets how many values in the range to try, can do 14 but its slower.
rf_models=tune_grid(rf_specs,
popularity~.,
cv_plan,
grid=mtry_grid)
autoplot(rf_models)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
cat("The best value of mtry is",best_mtry)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
paste0("The best value of mtry is", best_mtry)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
paste0("The best value of mtry is", best_mtry)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
paste0("The best value of mtry is ", best_mtry$mtry)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
cat("The best value of mtry is ", best_mtry$mtry)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
cat("The best value of mtry is", best_mtry$mtry)
# Step 1: Model specification
rf_specs=rand_forest(mtry=tune()) |>
set_engine("ranger") |>  # can also use randomForest but ranger is usually preferred
set_mode("regression")
# Step 2: Resampling procedure - switch to five folds for faster performance
cv_plan =vfold_cv(train_set[,4:19],v=5)
# Step 3: Parameter tuning/ Model evaluation
# Set mtry_grid
mtry_grid=grid_regular(
finalize(mtry(),train_set[,5:19]), # This line gives mtry the range of 1 to max number of features
levels = 5)  #Sets how many values in the range to try, can do 14 but its slower.
rf_models=tune_grid(rf_specs,
popularity~.,
cv_plan,
grid=mtry_grid)
autoplot(rf_models)
best_mtry=select_best(rf_models,metric="rmse")
cat("The best value of mtry is", best_mtry$mtry)
rf_best=finalize_model(rf_specs,best_mtry)
rf_fit=fit(rf_best,
popularity~.,
train_set[,4:19])
rf_best=finalize_model(rf_specs,best_mtry)
rf_fit=fit(rf_best,
popularity~.,
train_set[,4:19],
importance="impurity")
rf_best=finalize_model(rf_specs,best_mtry,
importance="impurity")
rf_best=finalize_model(rf_specs,best_mtry)
rf_fit=fit(rf_best,
popularity~.,
train_set[,4:19])
rf_pred=predict(rf_fit,test_set)
SSE=sum((test_set$popularity-rf_pred)^2)
1-SSE/SST
