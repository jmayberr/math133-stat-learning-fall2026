predict_regsubsets = function(fit_reg, newdata, id) {
# Get formula from regsubsets fit
form = as.formula(fit_reg$call[[2]])
# Get model matrix X for newdata
X = model.matrix(form, newdata)
# Get estimated coefficients for model of size id
betahat = coef(fit_reg, id = id)
# Extract only the columns we need since X may have additional columns
xvars = names(betahat)
# Compute predictions as X*betahat
X[, xvars] %*% betahat
}
