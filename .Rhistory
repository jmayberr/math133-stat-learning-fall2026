season_type == "REG"
) %>%
dplyr::arrange(player_id, season, week) %>%
dplyr::group_by(player_id, season) %>%
dplyr::mutate(
# Average PPR over all previous games
prior_ppr_avg = dplyr::lag(
cummean(fantasy_points_ppr)
),
# Average target share over the previous 3 games
prior_target_share = dplyr::lag(
slider::slide_dbl(
target_share,
mean,
.before = 2,
.complete = TRUE,
na.rm = TRUE
)
),
# Average air-yards share over the previous 3 games
prior_air_yards_share = dplyr::lag(
slider::slide_dbl(
air_yards_share,
mean,
.before = 2,
.complete = TRUE,
na.rm = TRUE
)
)
) %>%
dplyr::ungroup() %>%
dplyr::rename(
actual_ppr = fantasy_points_ppr,
defense = opponent_team
) %>%
dplyr::select(
season,
week,
player_id,
player_display_name,
team,
defense,
target_share,
air_yards_share,
prior_ppr_avg,
prior_target_share,
prior_air_yards_share,
actual_ppr
)
train = wr_data %>%
dplyr::filter(season <= 2025) %>%
tidyr::drop_na(
actual_ppr,
prior_ppr_avg,
prior_target_share,
prior_air_yards_share,
defense
) %>%
dplyr::mutate(defense = factor(defense))
test = wr_data %>%
dplyr::filter(season == 2026) %>%
tidyr::drop_na(
actual_ppr,
prior_ppr_avg,
prior_target_share,
prior_air_yards_share,
defense
) %>%
dplyr::mutate(
defense = factor(
defense,
levels = levels(train$defense)
)
)
share_lm = lm(
actual_ppr ~ prior_ppr_avg +
prior_target_share +
prior_air_yards_share +
defense,
data = train
)
yhat = predict(share_lm, newdata = test)
calculate_metrics(
y = test$actual_ppr,
yhat = yhat
)
